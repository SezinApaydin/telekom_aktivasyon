<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="007-addresses-initial" author="sezin">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="addresses" schemaName="telekom"/>
            </not>
        </preConditions>

        <createTable tableName="addresses" schemaName="telekom">
            <column name="id" type="serial">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="city" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="district" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="postal_code" type="varchar(10)"/>
            <column name="address_line" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>