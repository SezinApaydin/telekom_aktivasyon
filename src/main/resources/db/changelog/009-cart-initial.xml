<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="009-cart-initial" author="sezin">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="cart" schemaName="telekom"/>
            </not>
        </preConditions>

        <createTable tableName="cart" schemaName="telekom">
            <column name="id" type="serial">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="customer_identifier" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(20)" defaultValue="active">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql>ALTER TABLE telekom.cart ADD CONSTRAINT cart_status_check CHECK (status IN ('active', 'checked_out', 'expired'));</sql>
    </changeSet>

</databaseChangeLog>