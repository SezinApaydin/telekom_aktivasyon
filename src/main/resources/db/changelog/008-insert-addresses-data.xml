            <column name="district" value="tepebaşı"/>
            <column name="postal_code" value="26111"/>
            <column name="address_line" value="atatürk cd."/>
        </insert>
        <insert tableName="addresses" schemaName="telekom">
            <column name="id" valueNumeric="6"/>
            <column name="city" value="eskişehir"/>
            <column name="district" value="tepebaşı"/>
            <column name="postal_code" value="26111"/>
            <column name="address_line" value="atatürk cd."/>
        </insert>

        <sql>SELECT setval(pg_get_serial_sequence('telekom.addresses', 'id'), (SELECT MAX(id) FROM telekom.addresses));</sql>
    </changeSet>

</databaseChangeLog>