<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="008-insert-addresses-data" author="sezin">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM telekom.addresses</sqlCheck>
        </preConditions>

        <insert tableName="addresses" schemaName="telekom">
            <column name="id" valueNumeric="1"/>
            <column name="city" value="Eskişehir"/>
            <column name="district" value="Tepebaşı"/>
            <column name="postal_code" value="26110"/>
            <column name="address_line" value="Yenibağlar Mah. No:5 D:2"/>
        </insert>
        <insert tableName="addresses" schemaName="telekom">
            <column name="id" valueNumeric="2"/>
            <column name="city" value="Eskişehir"/>
            <column name="district" value="Tepebaşı"/>
            <column name="postal_code" value="26110"/>
            <column name="address_line" value="Yenibağlar Mah. No:5 D:2"/>
        </insert>
        <insert tableName="addresses" schemaName="telekom">
            <column name="id" valueNumeric="3"/>
            <column name="city" value="Eskişehir"/>
            <column name="district" value="Tepebaşı"/>
            <column name="postal_code" value="26110"/>
            <column name="address_line" value="Cumhuriyet Mah. No:5 D:2"/>
        </insert>
        <insert tableName="addresses" schemaName="telekom">
            <column name="id" valueNumeric="4"/>
